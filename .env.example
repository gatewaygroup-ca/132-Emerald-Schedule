# Password for the admin/edit pages. Required.
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin login cookie. Required in production.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Supabase (required on Vercel so saved changes persist).
# Leave blank for local development: data is then saved to data/projects.local.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
