# Password for the admin/edit pages. Required.
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin login cookie. Recommended.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Saving on Vercel: schedules are stored in data/projects.json in this GitHub repo.
# Create a fine-grained GitHub token with "Contents: Read and write" on this repo only.
# Leave blank for local development (the file on disk is edited directly).
GITHUB_TOKEN=
# Optional. Detected automatically on Vercel.
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
